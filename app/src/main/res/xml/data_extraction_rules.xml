<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/device-transfer rules. Nothing is copied: the encrypted Firebase token is
     bound to this device's Keystore key, and Bluetooth/session state must not move to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
