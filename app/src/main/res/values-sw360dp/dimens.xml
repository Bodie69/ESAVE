<?xml version="1.0" encoding="utf-8"?>
<!-- Typical phones (360dp wide and up). -->
<resources>
    <!-- Screen edge padding; MainActivity widens it on large screens so content stays at most
         content_max_width wide and centered. -->
    <dimen name="screen_padding">16dp</dimen>
    <dimen name="content_max_width">640dp</dimen>

    <!-- App bar (a minimum: it grows if the system font is large) -->
    <dimen name="header_min_height">74dp</dimen>
    <dimen name="header_logo">50dp</dimen>
    <dimen name="header_seal">44dp</dimen>
    <dimen name="header_title_text">18sp</dimen>
    <dimen name="header_subtitle_text">12sp</dimen>

    <!-- Bottom navigation -->
    <dimen name="nav_min_height">76dp</dimen>
    <dimen name="nav_icon">28dp</dimen>
    <dimen name="nav_label_text">10sp</dimen>

    <!-- Devices screen: bulbs two per row, fans two per row -->
    <dimen name="relay_bulb">96dp</dimen>
    <dimen name="relay_glow">124dp</dimen>
    <dimen name="relay_fan">112dp</dimen>
    <dimen name="relay_card_min_height">344dp</dimen>
    <dimen name="relay_label_text">13sp</dimen>

    <!-- Metric cards and chart -->
    <dimen name="metric_card_min_height">156dp</dimen>
    <dimen name="metric_card_min_height_compact">104dp</dimen>
    <dimen name="chart_height">190dp</dimen>

    <!-- Splash -->
    <dimen name="splash_logo">140dp</dimen>
    <dimen name="splash_seal">124dp</dimen>
    <dimen name="splash_title_text">24sp</dimen>
    <dimen name="splash_subtitle_text">15sp</dimen>
</resources>
