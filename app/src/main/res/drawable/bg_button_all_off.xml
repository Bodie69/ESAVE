<?xml version="1.0" encoding="utf-8"?>
<!-- ALL OFF button: glows while selected (every relay is off), like bg_button_mode. Every state
     keeps the same 3dp transparent rim so the button does not change size when the glow turns on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_pressed="true">
        <layer-list>
            <item><shape><solid android:color="#33DC2626"/><corners android:radius="17dp"/></shape></item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape><solid android:color="#B91C1C"/><stroke android:width="1dp" android:color="#FCA5A5"/><corners android:radius="14dp"/></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item><shape><solid android:color="#26DC2626"/><corners android:radius="17dp"/></shape></item>
            <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
                <shape><solid android:color="#4DDC2626"/><corners android:radius="15.5dp"/></shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape><solid android:color="#DC2626"/><stroke android:width="1dp" android:color="#FCA5A5"/><corners android:radius="14dp"/></shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape><solid android:color="#FFE1E1"/><stroke android:width="1dp" android:color="#DC2626"/><corners android:radius="14dp"/></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape><solid android:color="#FFF5F5"/><stroke android:width="1dp" android:color="#FCA5A5"/><corners android:radius="14dp"/></shape>
            </item>
        </layer-list>
    </item>
</selector>
