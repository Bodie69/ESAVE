<?xml version="1.0" encoding="utf-8"?>
<!-- Raised metric tile: same depth treatment as bg_card, tighter padding. -->
<!-- paddingMode="stack": the first layer's padding pads the content only; without it every later
     layer is inset by that padding and draws a second, smaller box behind the text. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:paddingMode="stack">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#F2F7FE" />
            <stroke android:width="1dp" android:color="#E3EAF3" />
            <corners android:radius="18dp" />
            <padding android:left="14dp" android:top="14dp" android:right="14dp" android:bottom="14dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#B3FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
