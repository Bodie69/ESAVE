<?xml version="1.0" encoding="utf-8"?>
<!-- Raised card: soft top-to-bottom gradient, hairline border and a bright top edge. The
     shadow comes from the Card style's elevation; this drawable's outline shapes it. -->
<!-- paddingMode="stack": the first layer's padding pads the content only; without it every later
     layer is inset by that padding and draws a second, smaller box behind the text. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:paddingMode="stack">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFFFFF" android:endColor="#F4F8FD" />
            <stroke android:width="1dp" android:color="#E3EAF3" />
            <corners android:radius="20dp" />
            <padding android:left="16dp" android:top="16dp" android:right="16dp" android:bottom="16dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#B3FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
