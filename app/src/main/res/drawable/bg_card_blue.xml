<?xml version="1.0" encoding="utf-8"?>
<!-- Hero status card: deep blue gradient with a soft light source in the top-right corner. -->
<!-- paddingMode="stack": the first layer's padding pads the content only; without it every later
     layer is inset by that padding and draws a second, smaller box behind the text. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:paddingMode="stack">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#06417F" android:endColor="#0B6EF3" />
            <corners android:radius="22dp" />
            <padding android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.92" android:centerY="0.05"
                android:gradientRadius="220dp" android:startColor="#38FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
