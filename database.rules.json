{
  // ESAVE - Realtime Database security rules.
  //
  // Access is granted per Firebase Auth UID through /access, which is edited only from the
  // Firebase console (rules never allow client writes there):
  //   /access/controllers/<esp32 uid>         = "room206"   ESP32 account for that room
  //   /access/operators/<app uid>/room206     = true        app users allowed to control it
  // One account may appear in both lists if the app and the ESP32 share a login.
  //
  // Data flow per room:
  //   state     ESP32 writes (full PUT), operators read
  //   commands  operators write, ESP32 reads
  //   acks/last ESP32 writes, operators read
  "rules": {
    ".read": false,
    ".write": false,

    "access": {
      ".read": false,
      ".write": false
    },

    "rooms": {
      "$roomId": {
        "state": {
          ".read": "auth != null && (root.child('access/operators/' + auth.uid + '/' + $roomId).val() === true || root.child('access/controllers/' + auth.uid).val() === $roomId)",
          ".write": "auth != null && root.child('access/controllers/' + auth.uid).val() === $roomId",
          ".validate": "newData.hasChildren(['schema_version', 'room_id', 'mode', 'telemetry_sequence', 'server_timestamp_ms', 'connectivity', 'occupancy', 'energy', 'relays'])",
          "room_id": { ".validate": "newData.val() === $roomId" },
          "mode": { ".validate": "newData.val() === 'AUTO' || newData.val() === 'MANUAL'" },
          "schema_version": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "telemetry_sequence": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          // The app judges controller freshness from this, so it must be the real server time
          // (the firmware writes {".sv": "timestamp"}).
          "server_timestamp_ms": { ".validate": "newData.val() === now" },
          "occupancy": {
            ".validate": "newData.hasChildren(['count', 'valid'])",
            "count": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999" },
            "valid": { ".validate": "newData.isBoolean()" }
          },
          "energy": {
            ".validate": "newData.hasChild('valid')",
            "valid": { ".validate": "newData.isBoolean()" }
          },
          "relays": {
            "$device": { ".validate": "$device.matches(/^(light[1-4]|fan[12])$/) && newData.isBoolean()" }
          },
          "relay_gpio_verified": {
            "$device": { ".validate": "$device.matches(/^(light[1-4]|fan[12])$/) && newData.isBoolean()" }
          }
        },

        "commands": {
          ".read": "auth != null && root.child('access/controllers/' + auth.uid).val() === $roomId",
          ".write": "auth != null && root.child('access/operators/' + auth.uid + '/' + $roomId).val() === true",

          // Every command is a full PUT of {command_id, source, requested_at_ms, ...payload}.
          "mode": {
            ".validate": "newData.hasChildren(['command_id', 'source', 'requested_at_ms', 'mode'])",
            "command_id": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "source": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "requested_at_ms": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "mode": { ".validate": "newData.val() === 'auto' || newData.val() === 'manual'" },
            "$other": { ".validate": false }
          },
          "devices": {
            "$device": {
              ".validate": "$device.matches(/^(light[1-4]|fan[12])$/) && newData.hasChildren(['command_id', 'source', 'requested_at_ms', 'state'])",
              "command_id": { ".validate": "newData.isNumber() && newData.val() > 0" },
              "source": { ".validate": "newData.isString() && newData.val().length <= 64" },
              "requested_at_ms": { ".validate": "newData.isNumber() && newData.val() > 0" },
              "state": { ".validate": "newData.isBoolean()" },
              "$other": { ".validate": false }
            }
          },
          "all_off": {
            ".validate": "newData.hasChildren(['command_id', 'source', 'requested_at_ms'])",
            "command_id": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "source": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "requested_at_ms": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "$other": { ".validate": false }
          },
          "set_count": {
            ".validate": "newData.hasChildren(['command_id', 'source', 'requested_at_ms', 'count'])",
            "command_id": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "source": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "requested_at_ms": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "count": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && newData.val() % 1 === 0" },
            "$other": { ".validate": false }
          },
          "calibrate_ir": {
            ".validate": "newData.hasChildren(['command_id', 'source', 'requested_at_ms'])",
            "command_id": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "source": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "requested_at_ms": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "$other": { ".validate": false }
          },
          "reset_energy": {
            ".validate": "newData.hasChildren(['command_id', 'source', 'requested_at_ms'])",
            "command_id": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "source": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "requested_at_ms": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "$other": { ".validate": false }
          },
          // Firmware V25.20+: stop Firebase and turn the controller's Bluetooth on for a while.
          "bluetooth_session": {
            ".validate": "newData.hasChildren(['command_id', 'source', 'requested_at_ms'])",
            "command_id": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "source": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "requested_at_ms": { ".validate": "newData.isNumber() && newData.val() > 0" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },

        "acks": {
          ".read": "auth != null && (root.child('access/operators/' + auth.uid + '/' + $roomId).val() === true || root.child('access/controllers/' + auth.uid).val() === $roomId)",
          "last": {
            ".write": "auth != null && root.child('access/controllers/' + auth.uid).val() === $roomId",
            ".validate": "newData.hasChildren(['command_id', 'action', 'ok', 'detail', 'server_timestamp_ms'])",
            "command_id": { ".validate": "newData.isNumber()" },
            "action": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "ok": { ".validate": "newData.isBoolean()" },
            "detail": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "device_epoch": { ".validate": "newData.isNumber()" },
            "server_timestamp_ms": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          },
          // One ACK per command (firmware V25.16+), so several phones never overwrite each
          // other's ACK. The ESP32 writes it; the operator who sent the command deletes it.
          "by_id": {
            "$commandId": {
              ".write": "auth != null && (root.child('access/controllers/' + auth.uid).val() === $roomId || (!newData.exists() && root.child('access/operators/' + auth.uid + '/' + $roomId).val() === true))",
              ".validate": "$commandId.matches(/^[0-9]{1,20}$/) && newData.hasChildren(['command_id', 'action', 'ok', 'detail', 'server_timestamp_ms'])",
              "command_id": { ".validate": "newData.isNumber()" },
              "action": { ".validate": "newData.isString() && newData.val().length <= 64" },
              "ok": { ".validate": "newData.isBoolean()" },
              "detail": { ".validate": "newData.isString() && newData.val().length <= 128" },
              "device_epoch": { ".validate": "newData.isNumber()" },
              "server_timestamp_ms": { ".validate": "newData.val() === now" },
              "$other": { ".validate": false }
            }
          }
        },

        // One cumulative PZEM reading per local (UTC+8) hour, keyed YYYYMMDDHH. ESP32 writes,
        // operators read; the app derives hourly/daily kWh from consecutive readings.
        "energy_history": {
          ".read": "auth != null && (root.child('access/operators/' + auth.uid + '/' + $roomId).val() === true || root.child('access/controllers/' + auth.uid).val() === $roomId)",
          "hourly": {
            "$hourKey": {
              ".write": "auth != null && root.child('access/controllers/' + auth.uid).val() === $roomId",
              ".validate": "$hourKey.matches(/^20[0-9][0-9](0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])([01][0-9]|2[0-3])$/) && newData.hasChildren(['kwh', 'epoch', 'ts'])",
              "kwh": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
              "epoch": { ".validate": "newData.isNumber() && newData.val() > 0" },
              "ts": { ".validate": "newData.val() === now" },
              "$other": { ".validate": false }
            }
          },
          "$other": { ".validate": false }
        },

        "$other": { ".read": false, ".write": false }
      }
    }
  }
}
